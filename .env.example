# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database: leave unset for SQLite, or provide a PostgreSQL URL
# DATABASE_URL=postgres://user:password@localhost:5432/plateau_nurse

# Public links
PUBLIC_BASE_URL=http://localhost:8000

# Expiry reminders
REMINDER_DAYS=30

# NIN encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
NIN_ENCRYPTION_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional admin alerts
SLACK_WEBHOOK_URL=
